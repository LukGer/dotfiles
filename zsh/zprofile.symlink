# The following lines were added by Docker Desktop to add commands to your PATH.
export PATH="$PATH:/Users/lukasrideamigos/.docker/bin"
# End of Docker Desktop section.

# Login shells only. Homebrew's shellenv sets PATH, MANPATH, INFOPATH and a
# few HOMEBREW_* variables; mise's shims are restored afterwards so mise
# still beats /opt/homebrew/bin for node.
#
# Non-interactive login shells also need the shims after brew shellenv.
# Interactive shells add mise's directory-change hook in zsh/tools.zsh.
# Keep the shim activation here after Homebrew's PATH changes.
eval "$(/opt/homebrew/bin/brew shellenv)"
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh --shims)"
fi
