# .zshenv is sourced by every zsh invocation, including non-interactive ones
# (scripts, `ssh host cmd`, editor tasks, agent sandboxes). It holds the minimum
# needed for a non-interactive shell to find the toolchains and personal bins.
#
# Full PATH construction happens in zsh/path.zsh, sourced from .zshrc; these
# toolchain entries are duplicated there, which `typeset -U path` collapses. They
# live here because non-interactive shells never reach .zshrc, and agents run
# `papercut` (a bun script in $DOTFILES/bin) from exactly such shells.
export DOTFILES="$HOME/.dotfiles"
export BUN_INSTALL="$HOME/.bun"
typeset -U path PATH
path=(
  "$DOTFILES/bin"
  "${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims"
  "$BUN_INSTALL/bin"
  "${(@)path:#$HOME/.volta/bin}"
)
unset VOLTA_HOME VOLTA_FEATURE_PNPM
export PATH
