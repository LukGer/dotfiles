#!/bin/zsh
# Usage: ghd review <owner/repo> <pr> [opencode|claude]
#
# Without a tool, shows the review menu. With one, checks the PR head out into
# a throwaway detached worktree, runs the pr-review skill in it, and removes
# the worktree when the agent exits. The agent only reads; this script owns
# every git write.

lib=${0:A:h}
repo=$1 pr=$2 tool=$3

if [[ -z $tool ]]; then
  if [[ -n $TMUX ]]; then
    selection=$(mktemp -t ghd-menu)
    tmux display-popup -E -x C -y C -w 64 -h 10 -b rounded -T "Review $repo#$pr" \
      -e "PATH=$PATH" "${(qq)lib}/menu > ${(qq)selection}"
    pick=$(<$selection)
    rm -f $selection
  else
    pick=$($lib/menu)
  fi
  case $pick in
    GPT-*) exec $lib/open popup $lib/review $repo $pr opencode ;;
    Opus*) exec $lib/open popup $lib/review $repo $pr claude ;;
    Past*) exec $lib/open popup $lib/history.py $repo $pr ;;
    Post*) exec $lib/open popup $lib/post.py $repo $pr ;;
  esac
  exit 0
fi

bell() {
  local terminal
  [[ -n $TMUX ]] && terminal=$(tmux display-message -p '#{client_tty}' 2>/dev/null)
  if [[ -n $terminal && -w $terminal ]]; then
    printf '\a' > $terminal
  else
    printf '\a'
  fi
}

fail() {
  bell
  [[ -n $out && ! -s $out.md ]] && rm -f $out.json
  print -u2 "$1"; print -u2 'Press any key...'; read -k 1; exit 1
}

IFS=$'\t' read -r title author head baseRef < <(gh pr view $pr --repo $repo \
  --json title,author,headRefOid,baseRefName -q '[.title, .author.login, .headRefOid, .baseRefName] | @tsv')
[[ -n $head ]] || fail "Could not load $repo#$pr."
printf '\n  \033[1;36m%s review\033[0m  %s#%s\n  %s  \033[2m(%s)\033[0m\n\n' $tool $repo $pr "$title" $author

store=${GHD_STORE:-$HOME/.local/share/gh-dash-reviews}
mkdir -p $store
out=$store/$(date +%Y%m%d-%H%M%S)__${repo//\//_}__${pr}__${tool}

clone=${GHD_CODE_DIR:-$HOME/dev}/${repo#*/}
worktree=$HOME/.cache/ghd/${repo#*/}-$pr-${head[1,7]}-$tool
merge_base=""
if [[ $(git -C $clone remote get-url origin 2>/dev/null) == *[:/]$repo(.git|) ]]; then
  print '  Fetching the PR into a detached worktree...'
  git -C $clone fetch -q origin "refs/pull/$pr/head" "+refs/heads/${baseRef}:refs/remotes/origin/${baseRef}" \
    || fail "Could not fetch $repo#$pr into $clone."
  git -C $clone worktree remove --force $worktree 2>/dev/null
  git -C $clone -c core.hooksPath=/dev/null worktree add -q --detach $worktree $head \
    || fail "Could not create $worktree."
  trap "git -C ${(q)clone} worktree remove --force ${(q)worktree}" EXIT
  merge_base=$(git -C $clone merge-base origin/$baseRef $head)
  cd $worktree
else
  print "  No clone of $repo in ${clone:h}, so this is a diff-only review."
  cd $(mktemp -d -t ghd-review)
fi

session=$(uuidgen | tr A-Z a-z)
[[ $tool == opencode ]] && session=ses_ghd${session//-/}
jq -n --arg repo $repo --argjson pr $pr --arg tool $tool --arg sha $head --arg title $title \
  --arg at "$(date '+%Y-%m-%d %H:%M')" --arg session $session --arg cwd $PWD \
  '{repo: $repo, pr: $pr, tool: $tool, sha: $sha, title: $title, at: $at, session: $session, cwd: $cwd}' > $out.json

brief="$repo#$pr
base: $baseRef
merge_base: ${merge_base:-none, no checkout: read the PR with gh pr diff}
head: $head
review_file: $out.md
findings_file: $out.findings
check: ghd check $out.findings${merge_base:+ --head $head}
tool: $tool"
previous=($store/*__${repo//\//_}__${pr}__*.findings(N.On))
if (( $#previous )); then
  prev=${previous[1]%.findings}
  brief+="
previous_review: $prev.md
previous_findings: $prev.findings
previous_sha: $(jq -r .sha $prev.json)"
fi
brief+="
For GitHub API reads, use gh api --method GET <endpoint>."

print '  Reviewing… scroll up for earlier output; q returns to live output. Ctrl+C cancels.'
SECONDS=0
export GHD_PROGRESS=$out.progress
case $tool in
  claude)
    permissions=("Edit(/$out.md)" "Edit(/$out.findings)"
      'Bash(gh pr view *)' 'Bash(gh pr diff *)' 'Bash(gh api --method GET *)'
      'Bash(git diff *)' 'Bash(git log *)' 'Bash(git show *)' 'Bash(git status *)' 'Bash(ghd check *)'
      mcp__atlassian__getAccessibleAtlassianResources mcp__atlassian__getJiraIssue mcp__atlassian__searchJiraIssuesUsingJql)
    python3 $lib/noninteractive.py python3 $lib/claude.py -p --model claude-opus-5-5 --setting-sources user --session-id $session \
      --mcp-config $lib/mcp.json --add-dir $store --allowedTools "${(j:,:)permissions}" \
      -n "#$pr review" "/pr-review $brief" ;;
  opencode) python3 $lib/noninteractive.py opencode run --agent pr-review --model 'openai/gpt-6.1-sol#high' \
    --session $session --title "#$pr review" "$brief" ;;
  *) fail "Unknown reviewer: $tool" ;;
esac || fail "$tool review failed."
[[ -s $out.md && -s $out.findings ]] || fail "$tool did not save the review and findings."
check_args=($out.findings)
[[ -n $merge_base ]] && check_args+=(--head $head)
python3 $lib/check.py "${check_args[@]}" || {
  mv $out.findings $out.findings.invalid
  fail "$tool saved invalid findings; kept as $out.findings.invalid."
}
jq --argjson seconds $SECONDS '. + {seconds: $seconds}' $out.json > $out.json.tmp && mv $out.json.tmp $out.json
bell
$lib/view $repo $pr $out.md || fail "The review viewer exited with an error."
