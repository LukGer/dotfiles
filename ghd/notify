#!/bin/zsh

rex_activity=0
if [[ $TERM_PROGRAM == rex || ( $TERM_PROGRAM == tmux && -n $REX_BLOCK ) ]]; then
  rex_activity=1
fi

notify() {
  local state=$1 message=$2 terminal alert=$'\a'
  if (( rex_activity )); then
    printf -v alert '\e]7501;state=%s:app=ghd:msg=%s\e\\' \
      "$state" "$(printf '%s' "$message" | base64 | tr -d '\n')"
  elif [[ $state != (done|error) ]]; then
    return 0
  fi
  [[ -n $TMUX ]] && terminal=$(tmux display-message -p '#{client_tty}' 2>/dev/null)
  if [[ -n $terminal && -w $terminal ]]; then
    printf '%s' "$alert" > $terminal
  elif [[ -t 1 || $alert == $'\a' ]]; then
    printf '%s' "$alert"
  else
    return 1
  fi
}

case $1 in
  is-rex) (( rex_activity )) ;;
  test)
    sleep 2
    if (( rex_activity )); then
      notify idle "Review sound test" || exit 1
      sleep 0.2
    fi
    notify done "Review sound test"
    ;;
  *) notify "$@" ;;
esac
