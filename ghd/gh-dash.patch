--- /dev/null
+++ b/internal/tui/components/prssection/stacks.go
@@ -0,0 +1,73 @@
+package prssection
+
+import "github.com/dlvhdr/gh-dash/v4/internal/tui/components/prrow"
+
+func groupStacks(prs []prrow.Data) []prrow.Data {
+	parents := make([]int, len(prs))
+	children := make([][]int, len(prs))
+	for i := range parents {
+		parents[i] = -1
+		prs[i].StackPrefix = ""
+	}
+	for i, child := range prs {
+		if child.Primary.State != "OPEN" || child.Primary.BaseRefName == "" {
+			continue
+		}
+		parent := -1
+		for j, candidate := range prs {
+			if i == j || candidate.Primary.State != "OPEN" ||
+				candidate.Primary.Repository.NameWithOwner != child.Primary.Repository.NameWithOwner ||
+				candidate.Primary.HeadRefName != child.Primary.BaseRefName ||
+				candidate.Primary.HeadRepository.NameWithOwner == "" ||
+				candidate.Primary.HeadRepository.NameWithOwner != child.Primary.Repository.NameWithOwner {
+				continue
+			}
+			if parent != -1 {
+				parent = -1
+				break
+			}
+			parent = j
+		}
+		for ancestor := parent; ancestor != -1; ancestor = parents[ancestor] {
+			if ancestor == i {
+				parent = -1
+				break
+			}
+		}
+		parents[i] = parent
+	}
+	for i, parent := range parents {
+		if parent != -1 {
+			children[parent] = append(children[parent], i)
+		}
+	}
+	grouped := make([]prrow.Data, 0, len(prs))
+	visited := make([]bool, len(prs))
+	var appendTree func(int)
+	appendTree = func(i int) {
+		visited[i] = true
+		grouped = append(grouped, prs[i])
+		for _, child := range children[i] {
+			appendTree(child)
+		}
+	}
+	for i := range prs {
+		root := i
+		for parents[root] != -1 {
+			root = parents[root]
+		}
+		if visited[root] {
+			continue
+		}
+		start := len(grouped)
+		appendTree(root)
+		if len(grouped)-start > 1 {
+			for j := start; j < len(grouped); j++ {
+				grouped[j].StackPrefix = "├ "
+			}
+			grouped[start].StackPrefix = "┌ "
+			grouped[len(grouped)-1].StackPrefix = "└ "
+		}
+	}
+	return grouped
+}
