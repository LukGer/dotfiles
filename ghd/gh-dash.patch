+package prssection
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/charmbracelet/x/ansi"
+	"github.com/stretchr/testify/require"
+
+	"github.com/dlvhdr/gh-dash/v4/internal/config"
+	"github.com/dlvhdr/gh-dash/v4/internal/data"
+	"github.com/dlvhdr/gh-dash/v4/internal/tui/components/prrow"
+	"github.com/dlvhdr/gh-dash/v4/internal/tui/context"
+	"github.com/dlvhdr/gh-dash/v4/internal/tui/theme"
+)
+
+func stackPR(number int, base, head string) prrow.Data {
+	pr := &data.PullRequestData{
+		Number: number, Title: fmt.Sprintf("Change %d", number), State: "OPEN",
+		BaseRefName: base, HeadRefName: head,
+		Url:        fmt.Sprintf("https://github.com/owner/repo/pull/%d", number),
+		Repository: data.Repository{Name: "repo", NameWithOwner: "owner/repo"},
+	}
+	pr.HeadRepository.Name = "repo"
+	pr.HeadRepository.NameWithOwner = "owner/repo"
+	return prrow.Data{Primary: pr}
+}
+
+func stackList(t *testing.T, compact bool) Model {
+	t.Helper()
+	cfg, err := config.ParseConfig(config.Location{
+		ConfigFlag: "../../../config/testdata/test-config.yml", SkipGlobalConfig: true,
+	})
+	require.NoError(t, err)
+	cfg.Theme.Ui.Table.Compact = compact
+	thm := theme.ParseTheme(&cfg)
+	ctx := &context.ProgramContext{
+		Config: &cfg, Theme: thm, Styles: context.InitStyles(thm),
+		MainContentWidth: 160, MainContentHeight: 40,
+	}
+	m := NewModel(0, ctx, config.PrsSectionConfig{}, time.Now(), time.Now())
+	m.UpdateProgramContext(ctx)
+	return m
+}
+
+func receiveStackPage(m *Model, prs ...prrow.Data) {
+	m.LastFetch.TaskId = "stacks"
+	m.Update(SectionPullRequestsFetchedMsg{
+		TaskId: "stacks", Prs: prs, TotalCount: m.NumRows() + len(prs),
+		PageInfo: data.PageInfo{HasNextPage: true},
+	})
+}
+
+func TestFetchedPRsGroupStacksInDependencyOrder(t *testing.T) {
+	for _, compact := range []bool{false, true} {
+		t.Run(fmt.Sprintf("compact=%t", compact), func(t *testing.T) {
+			m := stackList(t, compact)
+			receiveStackPage(&m,
+				stackPR(14595, "develop", "labels"),
+				stackPR(14651, "develop", "leaderboards"),
+				stackPR(14614, "dry-run", "live"),
+				stackPR(14593, "labels", "dry-run"),
+			)
+			var numbers []int
+			for range m.NumRows() {
+				numbers = append(numbers, m.GetCurrRow().GetNumber())
+				m.NextRow()
+			}
+			require.Equal(t, []int{14595, 14593, 14614, 14651}, numbers)
+			titleColumn := 1
+			if compact {
+				titleColumn = 2
+			}
+			for i, prefix := range []string{"┌ ", "├ ", "└ ", ""} {
+				row := ansi.Strip(m.BuildRows()[i][titleColumn])
+				require.True(t, strings.HasPrefix(row, prefix), "row %d: %q", i, row)
+				if !compact {
+					continuation := []string{"│ ", "│ ", "  ", "Change"}[i]
+					require.True(t, strings.HasPrefix(strings.Split(row, "\n")[1], continuation), "row %d: %q", i, row)
+				}
+			}
+		})
+	}
+}
+
+func TestStackGroupsKeepSearchOrderAndEveryLoadedPR(t *testing.T) {
+	base := stackPR(1, "main", "base")
+	tip := stackPR(2, "base", "tip")
+	other := stackPR(9, "main", "other")
+	secondBase := stackPR(4, "main", "second")
+	secondTip := stackPR(5, "second", "second-tip")
+	for _, tc := range []struct {
+		name string
+		prs  []prrow.Data
+		want []int
+	}{
+		{"empty", nil, []int{}},
+		{"unrelated", []prrow.Data{other, base}, []int{9, 1}},
+		{"parent loaded last", []prrow.Data{tip, other, base}, []int{1, 2, 9}},
+		{"group after unrelated PR", []prrow.Data{other, tip, base}, []int{9, 1, 2}},
+		{"two interleaved stacks", []prrow.Data{tip, secondBase, base, secondTip, other}, []int{1, 2, 4, 5, 9}},
+		{"branching", []prrow.Data{base, tip, stackPR(3, "base", "sibling"), stackPR(6, "tip", "top")}, []int{1, 2, 6, 3}},
+		{"ambiguous parent", []prrow.Data{tip, base, stackPR(3, "main", "base")}, []int{2, 1, 3}},
+		{"cyclic branches", []prrow.Data{stackPR(1, "tip", "base"), tip}, []int{2, 1}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			m := stackList(t, false)
+			receiveStackPage(&m, tc.prs...)
+			numbers := []int{}
+			for range m.NumRows() {
+				numbers = append(numbers, m.GetCurrRow().GetNumber())
+				m.NextRow()
+			}
+			require.Equal(t, tc.want, numbers)
+			require.Equal(t, len(tc.prs), len(m.BuildRows()))
+		})
+	}
+}
+
+func TestRefreshRemovesMarkersWhenOnlyOneStackMemberRemains(t *testing.T) {
+	m := stackList(t, false)
+	receiveStackPage(&m, stackPR(1, "main", "base"), stackPR(2, "base", "tip"))
+	m.ResetRows()
+	m.PageInfo = nil
+	receiveStackPage(&m, stackPR(2, "base", "tip"))
+	require.Equal(t, 1, m.NumRows())
+	row := ansi.Strip(m.BuildRows()[0][1])
+	require.NotContains(t, row, "┌")
+	require.NotContains(t, row, "└")
+	require.NotContains(t, row, "│")
+}
+
+func TestLoadingStackMembersKeepsTheSelectedPR(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		initial  []prrow.Data
+		next     prrow.Data
+		selected int
+	}{
+		{"parent arrives", []prrow.Data{stackPR(3, "base", "tip"), stackPR(9, "main", "other")}, stackPR(1, "main", "base"), 0},
+		{"child arrives before selection", []prrow.Data{stackPR(1, "main", "base"), stackPR(9, "main", "other")}, stackPR(3, "base", "tip"), 1},
+		{"parent arrives before selection", []prrow.Data{stackPR(3, "base", "tip"), stackPR(9, "main", "other")}, stackPR(1, "main", "base"), 1},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			m := stackList(t, false)
+			receiveStackPage(&m, tc.initial...)
+			for range tc.selected {
+				m.NextRow()
+			}
+			selected := m.GetCurrRow().GetUrl()
+			receiveStackPage(&m, tc.next)
+			require.Equal(t, selected, m.GetCurrRow().GetUrl())
+		})
+	}
+}
+
+func TestUnrelatedBranchesDoNotFormStacks(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		change func(*data.PullRequestData)
+	}{
+		{"different repository", func(pr *data.PullRequestData) { pr.Repository.NameWithOwner = "owner/other" }},
+		{"fork with same repository name", func(pr *data.PullRequestData) { pr.HeadRepository.NameWithOwner = "fork/repo" }},
+		{"deleted head repository", func(pr *data.PullRequestData) { pr.HeadRepository.NameWithOwner = "" }},
+		{"merged parent", func(pr *data.PullRequestData) { pr.State = "MERGED" }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			m := stackList(t, false)
+			parent := stackPR(1, "main", "base")
+			tc.change(parent.Primary)
+			receiveStackPage(&m, stackPR(2, "base", "tip"), parent)
+			require.Equal(t, 2, m.GetCurrRow().GetNumber())
+			for _, row := range m.BuildRows() {
+				require.NotContains(t, ansi.Strip(row[1]), "┌")
+				require.NotContains(t, ansi.Strip(row[1]), "└")
+			}
+		})
+	}
+}
