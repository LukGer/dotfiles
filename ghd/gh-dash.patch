@@ -0,0 +1,48 @@
+package prview
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+
+	"github.com/dlvhdr/gh-dash/v4/internal/data"
+)
+
+func (m *Model) renderDeployments() string {
+	if !m.pr.Data.IsEnriched {
+		return ""
+	}
+	latest := make(map[string]data.Deployment)
+	deployments := []data.Deployment{}
+	for _, commit := range []*data.DeployedCommit{m.pr.Data.Enriched.MergeCommit, m.pr.Data.Enriched.PotentialMergeCommit} {
+		if commit != nil {
+			deployments = append(deployments, commit.Deployments.Nodes...)
+		}
+	}
+	for _, node := range m.pr.Data.Enriched.AllCommits.Nodes {
+		deployments = append(deployments, node.Commit.Deployments.Nodes...)
+	}
+	for _, deployment := range deployments {
+		previous, exists := latest[deployment.Environment]
+		if !exists || deployment.CreatedAt.After(previous.CreatedAt) {
+			latest[deployment.Environment] = deployment
+		}
+	}
+	if len(latest) == 0 {
+		return m.ctx.Styles.Common.FaintTextStyle.Render("Deployments: none") + "\n\n"
+	}
+	names := make([]string, 0, len(latest))
+	for name := range latest {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	lines := []string{m.ctx.Styles.Common.MainTextStyle.Underline(true).Render("Deployments · O open")}
+	for _, name := range names {
+		deployment := latest[name]
+		lines = append(lines, fmt.Sprintf("%s · %s", name, deployment.State))
+		if deployment.LatestStatus != nil && deployment.LatestStatus.EnvironmentUrl != "" {
+			lines = append(lines, deployment.LatestStatus.EnvironmentUrl)
+		}
+	}
+	return strings.Join(lines, "\n") + "\n\n"
+}
