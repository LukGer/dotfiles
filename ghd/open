#!/bin/zsh
# Usage: ghd open tab|split|window|popup <command> [args...]
#
# Runs the command in a new Ghostty surface with this shell's PATH and working
# directory. Ghostty runs it as `exec -l <command>`, so it must be one command,
# not a shell snippet. Outside Ghostty the command runs here instead.

kind=$1; shift
if [[ $kind == popup ]]; then
  if [[ -n $TMUX ]]; then
    exec tmux display-popup -E -x C -y C -w 90% -h 80% -b rounded \
      -d "$PWD" -e "PATH=$PATH" "env TERM_PROGRAM=${(qq)TERM_PROGRAM} ${(j: :)${(qq)@}}"
  fi
  exec "$@"
fi
if [[ $TERM_PROGRAM != ghostty && $kind != window ]]; then
  exec "$@"
fi
osascript - $kind "${(j: :)${(qq)@}}" $PWD "PATH=$PATH" >/dev/null <<'APPLESCRIPT'
on run {kind, cmd, cwd, pathEnv}
  tell application "Ghostty"
    set cfg to new surface configuration
    set command of cfg to cmd
    set initial working directory of cfg to cwd
    set environment variables of cfg to {pathEnv}
    if kind is "window" then
      new window with configuration cfg
    else if kind is "tab" then
      new tab in front window with configuration cfg
    else
      split (focused terminal of selected tab of front window) direction down with configuration cfg
    end if
  end tell
end run
APPLESCRIPT
