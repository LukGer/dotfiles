#!/bin/zsh
# Usage: ghd view <owner/repo> <pr> <markdown file>
#
# Opens a saved review. On a terminal that is the review screen (`ghd tui`),
# where findings can be ticked, edited, posted, and the reviewer's conversation
# continued while its working directory exists. Elsewhere the markdown is
# printed.
lib=${0:A:h}
file=$3
[[ -t 1 ]] && exec $lib/tui ${file%.md}
PAGER=cat glow -p -s dark $file
