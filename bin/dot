#!/bin/sh
#
# dot
#
# `dot` handles installation, updates, things like that. Run it periodically
# to make sure you're on the latest and greatest.
#
# CREDIT: https://github.com/holman/dotfiles/blob/master/bin/dot

set -e

DOTFILES="$HOME/.dotfiles"

displayUsageAndExit() {
	echo "dot -- dotfiles management"
	echo ""
	echo "Usage: dot [options]"
	echo ""
	echo "Options:"
	echo "  -e, --edit    Open dotfiles directory for editing"
	echo "  -h, --help    Show this help message and exit"
	exit
}

while test $# -gt 0; do
	case "$1" in
		"-h"|"--help")
			displayUsageAndExit
			;;
		"-e"|"--edit")
			exec "${EDITOR:-cursor}" "$DOTFILES"
			exit
			;;
		*)
			echo "Invalid option: $1"
			displayUsageAndExit
			;;
	esac
	shift
done

# Update dotfiles themselves
echo "› git pull"
git -C "$DOTFILES" pull

# Upgrade homebrew
echo "› brew update"
brew update

# Install software (brew bundle + every topic's install.sh)
echo "› script/install"
"$DOTFILES/script/install"

# macOS defaults are deliberately NOT applied here. They are opinionated and
# occasionally destructive; run macos/set-defaults.sh by hand after reading it.
