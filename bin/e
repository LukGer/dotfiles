#!/bin/sh
#
# Quick shortcut to the editor.
#
#   $ e            # opens the current directory
#   $ e ~/dev/foo  # opens that directory
#
# CREDIT: https://github.com/holman/dotfiles/blob/master/bin/e

# $EDITOR may carry flags ("cursor --wait"), so expand it unquoted.
exec ${EDITOR:-cursor} "${1:-.}"
