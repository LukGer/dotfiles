#!/usr/bin/env bun
//
// Agents are told to call this in the moment (see ai/AGENTS.md). It must never
// punish them for doing so: every failure path prints a note and exits 0, since
// a logging tool that returns non-zero teaches agents to stop logging.

import { Database } from "bun:sqlite";
import { mkdirSync, readFileSync } from "node:fs";
import { join } from "node:path";
import { homedir } from "node:os";

const WRAP = 80;
// A papercut is two or three sentences. Anything past this is a pasted README,
// PR body, or command output that an agent piped in by accident — truncate it
// rather than letting one entry bury the whole log.
const MAX_CHARS = 1500;

const git = (...args) => {
  const p = Bun.spawnSync(["git", ...args], { stdout: "pipe", stderr: "ignore" });
  return p.exitCode === 0 ? p.stdout.toString().trim() : null;
};

// Harness is detectable; the model is not — agents are unreliable narrators
// about their own ID, so it only appears when passed explicitly via -m.
const harness = () => {
  const e = process.env;
  if (e.CLAUDECODE || e.CLAUDE_CODE_ENTRYPOINT) return "claude-code";
  if (e.CODEX_SANDBOX || e.CODEX_HOME || e.CODEX_THREAD_ID) return "codex";
  if (e.CURSOR_AGENT || e.CURSOR_TRACE_ID) return "cursor";
  if (e.OPENCODE || e.OPENCODE_BIN_PATH) return "opencode";
  if (e.AI_AGENT) return e.AI_AGENT.split("_")[0];
  return "shell";
};

const wrap = (text) =>
  text
    .split(/\n\s*\n/)
    .map((para) => {
      const words = para.split(/\s+/).filter(Boolean);
      const lines = [];
      let line = "";
      for (const word of words) {
        if (line && line.length + 1 + word.length > WRAP) {
          lines.push(line);
          line = word;
        } else {
          line = line ? `${line} ${word}` : word;
        }
      }
      if (line) lines.push(line);
      return lines.join("\n");
    })
    .join("\n\n");

const openDatabase = () => {
  const dir = join(homedir(), ".papercuts");
  mkdirSync(dir, { recursive: true, mode: 0o700 });
  const db = new Database(join(dir, "papercuts.sqlite"), { create: true });
  db.run("PRAGMA busy_timeout = 5000");
  db.run("PRAGMA journal_mode = WAL");
  db.run(`
    CREATE TABLE IF NOT EXISTS papercuts (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      created_at TEXT NOT NULL,
      harness TEXT NOT NULL,
      model TEXT,
      repository TEXT,
      directory TEXT NOT NULL,
      branch TEXT,
      message TEXT NOT NULL,
      status TEXT NOT NULL DEFAULT 'open' CHECK (status IN ('open', 'dismissed')),
      reason TEXT
    );
  `);
  return db;
};

const list = (db, args) => {
  if (args.some((arg) => !["--all", "--json"].includes(arg))) throw new Error("usage: papercut list [--all] [--json]");
  const rows = db.query(`SELECT * FROM papercuts ${args.includes("--all") ? "" : "WHERE status = 'open'"}
    ORDER BY created_at, id`).all();
  if (args.includes("--json")) {
    console.log(JSON.stringify(rows, null, 2));
    return;
  }
  for (const row of rows) {
    const who = row.model ? `${row.harness}/${row.model}` : row.harness;
    console.log(`#${row.id} – ${row.status} – ${row.created_at} – ${who}`);
    console.log(`${row.directory}${row.branch ? ` – ${row.branch}` : ""}\n`);
    console.log(`${wrap(row.message)}${row.reason ? `\n\nReason: ${row.reason}` : ""}\n`);
  }
  console.log(`${rows.length} ${args.includes("--all") ? "total" : "open"} papercut${rows.length === 1 ? "" : "s"} across all sources`);
};

const settle = (db, command, args) => {
  const at = args.indexOf("--reason");
  const ids = command === "dismiss" && at !== -1 ? args.slice(0, at) : args;
  const reason = at === -1 ? "" : args.slice(at + 1).join(" ").trim();
  if (!ids.length || ids.some((id) => !/^[1-9]\d*$/.test(id) || !Number.isSafeInteger(Number(id))) ||
      (command === "dismiss" && !reason)) {
    throw new Error(`usage: papercut ${command} <id>...${command === "dismiss" ? ' --reason "..."' : ""}`);
  }
  db.transaction(() => {
    for (const id of ids) {
      if (!db.query("SELECT id FROM papercuts WHERE id = ?").get(Number(id))) throw new Error(`no papercut #${id}`);
    }
    for (const id of ids) {
      if (command === "resolve") db.query("DELETE FROM papercuts WHERE id = ?").run(Number(id));
      else db.query("UPDATE papercuts SET status = 'dismissed', reason = ? WHERE id = ?").run(reason, Number(id));
    }
  }).immediate();
  console.log(`${command === "resolve" ? "Resolved" : "Dismissed"} ${ids.map((id) => `#${id}`).join(", ")}`);
};

const usage = `papercut — log small friction to ~/.papercuts/papercuts.sqlite

  papercut "what you were doing, what got in the way, a guess at the cause"
  papercut -m claude-opus-5 "..."     record the model alongside the harness
  echo "..." | papercut               read the message from stdin
  papercut list [--all] [--json]        show papercuts across all sources
  papercut resolve <id>...             delete fixed entries
  papercut dismiss <id>... --reason "..."
                                      keep a won't-fix decision

Use -- before a message that starts with a command name.

Two or three sentences. Log it in the moment; don't stop to fix it.`;

const argv = process.argv.slice(2);
const command = argv[0];
const logging = !["list", "resolve", "dismiss"].includes(command);
let db;

try {
  if (command === "--help" || command === "-h") {
    console.log(usage);
    process.exit(0);
  }
  let model = null;
  const words = [];
  let message;
  if (logging) {
    for (let i = 0; i < argv.length; i++) {
      if (argv[i] === "--") {
        words.push(...argv.slice(i + 1));
        break;
      }
      if (argv[i] === "-m" || argv[i] === "--model") {
        model = argv[++i];
        if (!model) throw new Error("--model requires a model name");
      } else words.push(argv[i]);
    }
    message = words.join(" ").trim();
    if (!message && !process.stdin.isTTY) message = readFileSync(0, "utf8").trim();
    if (!message) {
      console.log(usage);
      process.exit(0);
    }
    if (message.length > MAX_CHARS) {
      message = `${message.slice(0, MAX_CHARS).trimEnd()}… [truncated ${message.length - MAX_CHARS} chars]`;
    }
  }

  db = openDatabase();
  if (command === "list") list(db, argv.slice(1));
  else if (command === "resolve" || command === "dismiss") settle(db, command, argv.slice(1));
  else {
    const commonDir = git("rev-parse", "--path-format=absolute", "--git-common-dir");
    const result = db.query(`INSERT INTO papercuts (created_at, harness, model, repository, directory, branch, message)
      VALUES (?, ?, ?, ?, ?, ?, ?)`).run(new Date().toISOString(), harness(), model, commonDir,
        process.cwd(), commonDir ? git("branch", "--show-current") || "detached" : null, message);
    console.log(`papercut #${result.lastInsertRowid} logged → ${join(homedir(), ".papercuts", "papercuts.sqlite")}`);
  }
} catch (error) {
  console.error(`papercut: ${error.message}${logging ? " (not logged)" : ""}`);
  process.exitCode = logging ? 0 : 1;
} finally {
  db?.close();
}
