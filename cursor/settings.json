{
  "workbench.settings.editor": "json",
  "workbench.iconTheme": "material-icon-theme",

  "window.nativeTabs": true,
  "window.systemColorTheme": "dark",

  // Fonts
  "editor.fontFamily": "'Monaspace Neon Var', monospace",
  "scm.inputFontFamily": "'Monaspace Neon Var', monospace",
  "terminal.integrated.fontFamily": "MesloLGS NF",
  "editor.inlineSuggest.fontFamily": "'Monaspace Neon Var', monospace",
  "debug.console.fontFamily": "'Monaspace Neon Var', monospace",
  "editor.codeLensFontFamily": "'Monaspace Neon Var', monospace",
  "notebook.output.fontFamily": "'Monaspace Neon Var', monospace",
  "markdown.preview.fontFamily": "'Monaspace Neon Var', monospace",
  "editor.inlayHints.fontFamily": "'Monaspace Neon Var', monospace",
  "editor.fontSize": 14,
  "terminal.integrated.fontSize": 14,
  "editor.fontLigatures": true,
  "window.commandCenter": false,
  "editor.scrollbar.vertical": "auto",
  "editor.scrollbar.horizontal": "auto",
  "window.titleBarStyle": "custom",
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",
  "window.restoreWindows": "folders",
  "window.closeWhenEmpty": true,
  "window.confirmBeforeClose": "keyboardOnly",
  // Toggle excluded files
  "files.exclude": {
    "**/.git": false,
    "**/.svn": false,
    "**/.hg": false,
    "**/CVS": false,
    "**/.DS_Store": false,
    "**/Thumbs.db": false,
    "**/node_modules": false,
    "**/.next": false,
    "**/.husky": false,
    "**/dist": false,
    "**/.todo.md": false,
    "**/.vscode": false,
    "**/.eslintrc.cjs": false,
    "**/.editorconfig": false,
    "**/.gitignore": false,
    "**/.lintstagedrc.mjs": false,
    "**/.markdownlint.json": false,
    "**/.markdownlintignore": false,
    "**/.prettierignore": false,
    "**/bun.lock": false,
    "**/cspell.json": false,
    "**/package-lock.json": false,
    "**/pnpm-lock.yaml": false,
    "**/next-env.d.ts": false,
    "**/postcss.config.cjs": false,
    "**/prettier.config.js": false,
    "**/next.config.js": false,
    "**/migrate.ts": false,
    "**/.env.example": false,
    "**/.sst": false,
    "**/.turbo": false,
    "**/.github": false
  },
  // Misc
  "workbench.startupEditor": "none",
  "explorer.compactFolders": true,
  "editor.tabSize": 2,
  "editor.linkedEditing": true,
  "breadcrumbs.filePath": "off",
  "files.trimTrailingWhitespace": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "workbench.editor.labelFormat": "short",
  "explorer.confirmDragAndDrop": false,
  "security.workspace.trust.banner": "never",
  "security.workspace.trust.untrustedFiles": "open",
  "security.workspace.trust.enabled": false,
  "explorer.confirmDelete": false,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit",
    "source.fixAll.biome": "explicit"
  },
  "git.openRepositoryInParentFolders": "always",
  "typescript.updateImportsOnFileMove.enabled": "never",
  "tailwindCSS.classFunctions": ["cva", "cx"],
  "git.autofetch": true,
  "extensions.ignoreRecommendations": true,
  "git.enableSmartCommit": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "git.confirmSync": false,
  "colorize.languages": [
    "css",
    "sass",
    "scss",
    "less",
    "postcss",
    "sss",
    "stylus",
    "xml",
    "svg",
    "typescript",
    "typescriptreact",
    "astro",
    "javascript"
  ],
  "terminal.integrated.inheritEnv": false,
  "explorer.fileNesting.enabled": false,
  "search.exclude": {
    "**/node_modules": true,
    "**/.git": true
  },
  "window.confirmSaveUntitledWorkspace": false,
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [80],
    "editor.selectionHighlight": false,
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off"
  },
  "editor.accessibilitySupport": "off",

  "markdown-pdf.displayHeaderFooter": false,
  "explorer.confirmPasteNative": false,
  "redhat.telemetry.enabled": true,
  "debug.onTaskErrors": "debugAnyway",
  "git.blame.statusBarItem.enabled": false,
  "git.blame.editorDecoration.enabled": true,
  "cursor.cpp.enablePartialAccepts": true,
  "workbench.editor.enablePreview": false,
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },

  "files.associations": {
    "*.css": "tailwindcss"
  },
  "tailwindCSS.classAttributes": ["class", "className", "headerClassName"],
  "diffEditor.ignoreTrimWhitespace": true,
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode"
  },
  "biome.requireConfiguration": true,
  "claudeCode.preferredLocation": "panel",
  "claudeCode.selectedModel": "default",
  "json.schemaDownload.enable": true,
  "cursor.composer.shouldChimeAfterChatFinishes": true,
  "security.promptForLocalFileProtocolHandling": false,
  "workbench.colorTheme": "GitHub Dark",
  "window.autoDetectColorScheme": false,
  "workbench.agentsWindowButton.enabled": false,
  "cursor.composer.editorConversationDensity": "detailed",
  "cursor.composer.usageSummaryDisplay": "always"
}
