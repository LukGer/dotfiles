# Generated by script/bootstrap from this template. Gitignored — this is where
# identity and anything machine-specific belongs.
[user]
	name = AUTHORNAME
	email = AUTHOREMAIL
	signingKey = SIGNINGKEY

[commit]
	gpgsign = true

[gpg]
	format = ssh

[credential]
	helper = GIT_CREDENTIAL_HELPER

# Per-directory identity, if you ever want work and personal emails separated:
#
# [includeIf "gitdir:~/dev/work/"]
#	path = ~/.gitconfig.work
