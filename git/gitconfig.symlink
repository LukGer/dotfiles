# Shared, publishable git config.
#
# Identity, signing keys and anything machine-specific go in ~/.gitconfig.local,
# which is generated by script/bootstrap and gitignored. Aliases are a separate
# include so they can be dropped in isolation.
[include]
	path = ~/.gitconfig.local
	path = ~/.gitconfig.aliases

[core]
	excludesfile = ~/.gitignore.global

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true
	default = simple

[pull]
	rebase = true

[rebase]
	autostash = true
	autosquash = true

[branch]
	autoSetupMerge = simple

# Record conflict resolutions and replay them if the same conflict recurs.
# Pays for itself the first time a long-lived branch is rebased twice.
[rerere]
	enabled = true

# diff3 shows the common ancestor in conflict markers, not just the two sides.
[merge]
	conflictStyle = diff3

[mergetool]
	keepBackup = false

[difftool]
	prompt = false

[color]
	ui = true

[help]
	autocorrect = 1

[maintenance]
	repo = /Users/lukasrideamigos/dev/unity
	repo = /Users/lukasrideamigos/dev/commutehub-app
